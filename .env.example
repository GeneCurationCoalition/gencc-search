APP_NAME=GenCC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# Database connection - points to gencc-sub database (read-only)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gencc_sub
DB_USERNAME=gencc_search_reader
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Google Cloud Storage - for serving pre-generated export files
# Only bucket is required; credentials use Application Default Credentials
# (gcloud auth application-default login, GCE metadata, etc.)
GOOGLE_CLOUD_STORAGE_BUCKET=
# GOOGLE_CLOUD_PROJECT_ID=        # optional: override ADC project
# GOOGLE_CLOUD_KEY_FILE=          # optional: path to service account JSON
