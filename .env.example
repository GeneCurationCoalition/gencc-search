APP_NAME=GenCC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

# Database connection - points to gencc-sub database (read-only)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gencc_sub
DB_USERNAME=gencc_search_reader
DB_PASSWORD=

# Rate limit: max requests per minute per IP for web routes (0 = disabled)
RATE_LIMIT=60

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
